":["وَمَا","لَكُم","مِّن","نَّـٰصِرِينَ",25,"۞ فَـَٔامَنَ","لَهُۥ","لُوطٌۭ ۘ","وَقَالَ"]},{"t":"a","w":["إِنِّى","مُهَاجِرٌ","إِلَىٰ","رَبِّىٓ ۖ","إِنَّهُۥ","هُوَ","ٱلْعَزِيزُ","ٱلْحَكِيمُ",26,"وَوَهَبْنَا"]},{"t":"a","w":["لَهُۥٓ","إِسْحَـٰقَ","وَيَعْقُوبَ","وَجَعَلْنَا","فِى","ذُرِّيَّتِهِ","ٱلنُّبُوَّةَ","وَٱلْكِتَـٰبَ"]},{"t":"a","w":["وَءَاتَيْنَـٰهُ","أَجْرَهُۥ","فِى","ٱلدُّنْيَا ۖ","وَإِنَّهُۥ","فِى","ٱلْـَٔاخِرَةِ","لَمِنَ","ٱلصَّـٰلِحِينَ"]},{"t":"a","w":[27,"وَلُوطًا","إِذْ","قَالَ","لِقَوْمِهِۦٓ","إِنَّكُمْ","لَتَأْتُونَ","ٱلْفَـٰحِشَةَ"]},{"t":"a","w":["مَا","سَبَقَكُم","بِهَا","مِنْ","أَحَدٍۢ","مِّنَ","ٱلْعَـٰلَمِينَ",28]},{"t":"a","w":["أَئِنَّكُمْ","لَتَأْتُونَ","ٱلرِّجَالَ","وَتَقْطَعُونَ","ٱلسَّبِيلَ","وَتَأْتُونَ"]},{"t":"a","w":["فِى","نَادِيكُمُ","ٱلْمُنكَرَ ۖ","فَمَا","كَانَ","جَوَابَ","قَوْمِهِۦٓ","إِلَّآ"]},{"t":"a","w":["أَن","قَالُوا۟","ٱئْتِنَا","بِعَذَابِ","ٱللَّهِ","إِن","كُنتَ","مِنَ","ٱلصَّـٰدِقِينَ"]},{"t":"a","w":[29,"قَالَ","رَبِّ","ٱنصُرْنِى","عَلَى","ٱلْقَوْمِ","ٱلْمُفْسِدِينَ",30]}]},"400":{"j":20,"h":40,"s":[29],"l":[{"t":"a","w":["وَلَمَّا","جَآءَتْ","رُسُلُنَآ","إِبْرَٰهِيمَ","بِٱلْبُشْرَىٰ","قَالُوٓا۟","إِنَّا","مُهْلِكُوٓا۟"]},{"t":"a","w":["أَهْلِ","هَـٰذِهِ","ٱلْقَرْيَةِ ۖ","إِنَّ","أَهْلَهَا","كَانُوا۟","ظَـٰلِمِينَ",31]},{"t":"a","w":["قَالَ","إِنَّ","فِيهَا","لُوطًۭا ۚ","قَالُوا۟","نَحْنُ","أَعْلَمُ","بِمَن","فِيهَا ۖ","لَنُنَجِّيَنَّهُۥ"]},{"t":"a","w":["وَأَهْلَهُۥٓ","إِلَّا","ٱمْرَأَتَهُۥ","كَانَتْ","مِنَ","ٱلْغَـٰبِرِينَ",32,"وَلَمَّآ"]},{"t":"a","w":["أَن","جَآءَتْ","رُسُلُنَا","لُوطًۭا","سِىٓءَ","بِهِمْ","وَضَاقَ","بِهِمْ","ذَرْعًۭا"]},{"t":"a","w":["وَقَالُوا۟","لَا","تَخَفْ","وَلَا","تَحْزَنْ ۖ","إِنَّا","مُنَجُّوكَ","وَأَهْلَكَ","إِلَّا","ٱمْرَأَتَكَ"]},{"t":"a","w":["كَانَتْ","مِنَ","ٱلْغَـٰبِرِينَ",33,"إِنَّا","مُنزِلُونَ","عَلَىٰٓ","أَهْلِ"]},{"t":"a","w":["هَـٰذِهِ","ٱلْقَرْيَةِ","رِجْزًۭا","مِّنَ","ٱلسَّمَآءِ","بِمَا","كَانُوا۟","يَفْسُقُونَ"]},{"t":"a","w":[34,"وَلَقَد","تَّرَكْنَا","مِنْهَآ","ءَايَ