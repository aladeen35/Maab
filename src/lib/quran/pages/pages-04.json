[4],"l":[{"t":"a","w":["أُو۟لَـٰٓئِكَ","ٱلَّذِينَ","لَعَنَهُمُ","ٱللَّهُ ۖ","وَمَن","يَلْعَنِ","ٱللَّهُ","فَلَن","تَجِدَ","لَهُۥ","نَصِيرًا",52]},{"t":"a","w":["أَمْ","لَهُمْ","نَصِيبٌۭ","مِّنَ","ٱلْمُلْكِ","فَإِذًۭا","لَّا","يُؤْتُونَ","ٱلنَّاسَ","نَقِيرًا",53,"أَمْ"]},{"t":"a","w":["يَحْسُدُونَ","ٱلنَّاسَ","عَلَىٰ","مَآ","ءَاتَىٰهُمُ","ٱللَّهُ","مِن","فَضْلِهِۦ ۖ","فَقَدْ","ءَاتَيْنَآ"]},{"t":"a","w":["ءَالَ","إِبْرَٰهِيمَ","ٱلْكِتَـٰبَ","وَٱلْحِكْمَةَ","وَءَاتَيْنَـٰهُم","مُّلْكًا","عَظِيمًۭا",54]},{"t":"a","w":["فَمِنْهُم","مَّنْ","ءَامَنَ","بِهِۦ","وَمِنْهُم","مَّن","صَدَّ","عَنْهُ ۚ","وَكَفَىٰ","بِجَهَنَّمَ","سَعِيرًا"]},{"t":"a","w":[55,"إِنَّ","ٱلَّذِينَ","كَفَرُوا۟","بِـَٔايَـٰتِنَا","سَوْفَ","نُصْلِيهِمْ","نَارًۭا","كُلَّمَا","نَضِجَتْ"]},{"t":"a","w":["جُلُودُهُم","بَدَّلْنَـٰهُمْ","جُلُودًا","غَيْرَهَا","لِيَذُوقُوا۟","ٱلْعَذَابَ ۗ","إِنَّ","ٱللَّهَ"]},{"t":"a","w":["كَانَ","عَزِيزًا","حَكِيمًۭا",56,"وَٱلَّذِينَ","ءَامَنُوا۟","وَعَمِلُوا۟","ٱلصَّـٰلِحَـٰتِ"]},{"t":"a","w":["سَنُدْخِلُهُمْ","جَنَّـٰتٍۢ","تَجْرِى","مِن","تَحْتِهَا","ٱلْأَنْهَـٰرُ","خَـٰلِدِينَ","فِيهَآ","أَبَدًۭا ۖ"]},{"t":"a","w":["لَّهُمْ","فِيهَآ","أَزْوَٰجٌۭ","مُّطَهَّرَةٌۭ ۖ","وَنُدْخِلُهُمْ","ظِلًّۭا","ظَلِيلًا",57,"۞ إِنَّ"]},{"t":"a","w":["ٱللَّهَ","يَأْمُرُكُمْ","أَن","تُؤَدُّوا۟","ٱلْأَمَـٰنَـٰتِ","إِلَىٰٓ","أَهْلِهَا","وَإِذَا","حَكَمْتُم","بَيْنَ"]},{"t":"a","w":["ٱلنَّاسِ","أَن","تَحْكُمُوا۟","بِٱلْعَدْلِ ۚ","إِنَّ","ٱللَّهَ","نِعِمَّا","يَعِظُكُم","بِهِۦٓ ۗ","إِنَّ","ٱللَّهَ","كَانَ","سَمِيعًۢا"]},{"t":"a","w":["بَصِيرًۭا",58,"يَـٰٓأَيُّهَا","ٱلَّذِينَ","ءَامَنُوٓا۟","أَطِيعُوا۟","ٱللَّهَ","وَأَطِيعُوا۟","ٱلرَّسُولَ","وَأُو۟لِى"]},{"t":"a","w":["ٱلْأَمْرِ","مِنكُمْ ۖ","فَإِن","تَنَـٰزَعْتُمْ","فِى","شَىْءٍۢ","فَرُدُّوهُ","إِلَى","ٱللَّهِ","وَٱلرَّسُولِ","إِن","كُنتُمْ"]},{"t":"a","w":["تُؤْمِنُونَ","بِٱللَّهِ","وَٱلْيَوْمِ","ٱلْـَٔاخِرِ ۚ","ذَٰلِكَ","خَيْرٌۭ","وَأَحْسَنُ","تَأْوِيلًا",59]}]},"88":{"j":5,"h":9,"s":[4],"l":[{"t":"a","w":["أَلَمْ","تَرَ","إِلَى","ٱلَّذِينَ",