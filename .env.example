# قاعدة البيانات (Postgres محلي أو Supabase). اتصال التطبيق بدور يملك الجداول،
# وكل طلب يُنفَّذ بدور authenticated مع هوية المستخدم فتنطبق سياسات RLS.
DATABASE_URL=postgres://maab:maab@localhost:5432/maab_dev

# demo: بيانات العرض بلا قاعدة | db: قاعدة البيانات
MAAB_DATA=db
NEXT_PUBLIC_MAAB_MODE=live

# سرّ توقيع جلسات الدخول (32 حرفاً على الأقل)
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# قنوات رمز الدخول: console تكتب الرمز في سجل الخادم وصندوق التطوير
WHATSAPP_DRIVER=console     # console | meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=maab_otp
SMS_DRIVER=console          # console | unifonic
UNIFONIC_APP_SID=
UNIFONIC_SENDER=MAAB
EMAIL_DRIVER=console        # console | smtp
SMTP_URL=
EMAIL_FROM="مآب <no-reply@example.com>"

# الدخول بحساب Google (المعرّف نفسه في الخادم والمتصفح؛ يختفي الزر إن تُرك فارغاً)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# روابط الحصص: mock تولّد روابط تجريبية، google تنشئ أحداث Calendar بـMeet
MEETING_PROVIDER=mock
GOOGLE_CALENDAR_ID=
GOOGLE_REFRESH_TOKEN=

# التخزين: local يحفظ في .storage، supabase لـBuckets خاصة
STORAGE_DRIVER=local
STORAGE_DIR=.storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# رابط التطبيق العام، وحجم مجمّع الاتصالات
APP_URL=http://localhost:3000
DB_POOL_MAX=10
